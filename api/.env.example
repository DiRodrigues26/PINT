# ─── Base de dados (MySQL Railway) ──────────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=softinsa_badges

# ─── JWT ────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Frontend URL (CORS — aceita várias origens separadas por vírgula) ─
FRONTEND_URL=http://localhost:5173

# ─── Email (opcional — sem config usa stub em logs) ─────────────────────
# SendGrid (prioritário quando definido)
SENDGRID_API_KEY=
# SMTP/Nodemailer (fallback)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ─── Firebase push mobile (opcional) ───────────────────────────────────
# JSON direto ou base64 da service account
FIREBASE_SERVICE_ACCOUNT=

# ─── Cloudinary (opcional — upload administrativo) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=softinsa-badges

# ─── Uploads ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── SLA ────────────────────────────────────────────────────────────────
SLA_JOB_INTERVAL_MIN=60

# ─── Ambiente ───────────────────────────────────────────────────────────
NODE_ENV=development
DISABLE_HTTPS_REDIRECT=true
PORT=3000
